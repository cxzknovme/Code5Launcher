{
  "name": "code5-launcher",
  "version": "1.0.7",
  "description": "Code5 Minecraft launcher with skins and automatic updates",
  "main": "main.js",
  "author": "knovme",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/cxzknovme/Code5Launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/cxzknovme/Code5Launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --universal"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "lucide": "^1.27.0",
    "minecraft-launcher-core": "^3.18.2",
    "skinview3d": "^3.4.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "xyz.joinserver.code5.launcher",
    "productName": "Code5 Launcher",
    "icon": "assets/code5-icon.png",
    "publish": {
      "provider": "github",
      "owner": "cxzknovme",
      "repo": "Code5Launcher",
      "releaseType": "release"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md",
      "!.git/**",
      "!.github/**",
      "!.idea/**",
      "!.npm-cache/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/code5-icon.png",
      "artifactName": "Code5Launcher-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/code5-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Code5Launcher-macOS.${ext}"
    }
  }
}
