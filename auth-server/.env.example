NODE_ENV=production
HOST=127.0.0.1
PORT=8787
AUTH_DOMAIN=auth.example.com

POSTGRES_DB=code5_auth
POSTGRES_USER=code5
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://code5:replace-with-a-long-random-password@db:5432/code5_auth

CODE_SECRET=replace-with-at-least-32-random-characters
SERVER_API_KEY=replace-with-a-different-32-character-secret
SESSION_DAYS=30
CODE_TTL_MINUTES=10
CODE_RESEND_SECONDS=60
LAUNCH_TICKET_SECONDS=90

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=code5.sender@gmail.com
SMTP_PASS=replace-with-16-character-app-password
SMTP_FROM=Code5 <code5.sender@gmail.com>
